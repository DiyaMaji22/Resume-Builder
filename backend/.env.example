# Copy to .env and adjust. Every variable is read from the environment.

# --- Django -----------------------------------------------------------------
# Required in production (50+ characters). Development has an insecure default.
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Number of trusted reverse proxies in front of the app (0 = none).
DJANGO_NUM_PROXIES=0
# Production only: redirect plain HTTP to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=resume-builder

# --- Auth -------------------------------------------------------------------
# Signs access and refresh tokens. Required in production (32+ characters).
JWT_KEY=

# --- Client -----------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# --- Cache (optional; Redis recommended with more than one process) ---------
REDIS_URL=

# --- AI suggestions (optional; any OpenAI-compatible endpoint) --------------
OPENAI_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gemma-3-27b-it
OPENAI_TIMEOUT_SECONDS=20
